{
  "name": "specworld",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "参数世界（specworld）— 华为/苹果在售手机可核查参数对比。Vite + Vue3 + TS + Tailwind 重构版，视觉基调为 Terraria / Minecraft 式像素美学。",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs && node scripts/sync-public.mjs",
    "build": "vite build",
    "postbuild": "node scripts/publish/verify-dist.mjs",
    "preview": "vite preview",
    "data": "node scripts/pipeline.mjs --data-only",
    "selftest": "node scripts/selftest.mjs",
    "i18n:residual": "node scripts/i18n-residual.mjs",
    "smoke:i18n": "node scripts/smoke/i18n-ssr.mjs",
    "smoke": "node _smoke.cjs",
    "smoke:pixel": "node _smoke-pixel.cjs",
    "smoke:font": "node _smoke-font.cjs",
    "smoke:search": "node _smoke-search.cjs",
    "smoke:canvas": "node _smoke-canvas.cjs",
    "smoke:globe": "node _smoke-globe.cjs",
    "smoke:all": "npm run selftest && npm run smoke:i18n && npm run smoke && npm run smoke:font && npm run smoke:pixel && npm run smoke:search && npm run smoke:canvas && npm run smoke:globe",
    "quality": "node scripts/report/quality.mjs",
    "editor": "node scripts/editor-server.mjs",
    "sprites:review": "node scripts/sprite/review.mjs",
    "archive": "node scripts/archive.mjs",
    "archive:check": "node scripts/archive.mjs --check",
    "lock:check": "node scripts/publish/normalize-lock.mjs",
    "lock:fix": "node scripts/publish/normalize-lock.mjs --write",
    "conventions:check": "node scripts/publish/check-conventions.mjs",
    "type-check": "vue-tsc --noEmit",
    "font:check": "node scripts/publish/check-font-coverage.mjs",
    "favicon:gates": "node scripts/verify-favicon-gates.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "qa:coverage": "node scripts/qa/coverage.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^14.0.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.12"
  }
}
