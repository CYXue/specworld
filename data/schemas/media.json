{
  "_doc": "多媒体播放器品类字段表（iPod classic/nano/shuffle/mini 起，MP3/MP4 类设备，用户 2026-10-15 决策命名）。与 audio（耳机/音箱）的结构性区别：media 是**内容消费终端**（有屏幕/存储/电池/系统），audio 是**发声外围**。屏幕按有无分：shuffle 无屏记 null。",
  "version": 1,
  "fields": [
    {
      "path": "body.heightMm",
      "label": "高度",
      "unit": "mm",
      "type": "number",
      "range": [
        25,
        1600
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "下界 iPod 时代口径（iPod mini 91mm）；上界按 110 英寸电视实测 1418mm 高 + 余量——智慧屏品类扩充时放宽"
    },
    {
      "path": "body.widthMm",
      "label": "宽度",
      "unit": "mm",
      "type": "number",
      "range": [
        15,
        2600
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "下界 iPod 时代口径（51–62mm）；上界按 110 英寸电视实测 2468mm 宽 + 余量——智慧屏品类扩充时放宽"
    },
    {
      "path": "body.depthMm",
      "label": "厚度",
      "unit": "mm",
      "type": "number",
      "range": [
        3,
        500
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "下界 iPod 时代口径（nano 5.4mm）；上界按 85 英寸电视含底座实测 413mm + 余量——智慧屏品类扩充时放宽"
    },
    {
      "path": "body.weightG",
      "label": "重量",
      "unit": "g",
      "type": "number",
      "range": [
        10,
        80000
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "下界 iPod 时代口径（103–184g）；上界按 110 英寸电视实测 70kg + 余量——智慧屏品类扩充时放宽"
    },
    {
      "path": "body.colors",
      "label": "配色",
      "unit": null,
      "type": "array:string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "body"
    },
    {
      "path": "display.sizeIn",
      "label": "屏幕尺寸",
      "unit": "英寸",
      "type": "number",
      "range": [
        1,
        120
      ],
      "dir": "high",
      "quantifiable": true,
      "group": "display",
      "note": "shuffle 无屏记 null；上界按最大电视 110 英寸 + 余量——智慧屏品类扩充时放宽"
    },
    {
      "path": "display.type",
      "label": "屏幕类型",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "display"
    },
    {
      "path": "display.resolutionPx",
      "label": "分辨率",
      "unit": null,
      "type": "object",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "display"
    },
    {
      "path": "display.ppi",
      "label": "像素密度",
      "unit": "ppi",
      "type": "number",
      "range": [
        80,
        330
      ],
      "dir": "high",
      "quantifiable": true,
      "group": "display",
      "note": "Retina 326ppi（touch 归 phone）；classic 163ppi、nano 202-220ppi"
    },
    {
      "path": "display.refreshHz",
      "label": "刷新率",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "display",
      "note": "官网原文（如「120 Hz | 倍频刷新率 240 Hz」），与 phone/display schema 同名同型；智慧屏品类扩充时新增"
    },
    {
      "path": "display.colorGamut",
      "label": "色域",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "display",
      "note": "官网原文（如「119% DCI-P3（典型值）」），与 tablet schema 同名同型；智慧屏品类扩充时新增"
    },
    {
      "path": "chipset.name",
      "label": "芯片",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "chipset",
      "note": "iPod nano 4 代起官方公布芯片（Samsung/苹果定制）；早期机型记 null"
    },
    {
      "path": "chipset.cpuCores",
      "label": "CPU 核心数",
      "unit": "核",
      "type": "number",
      "range": [
        1,
        8
      ],
      "dir": null,
      "quantifiable": false,
      "group": "chipset",
      "note": "iPod 主控非通用 CPU，官方未公布记 null；上界按小米盒子 4S Pro 的 Amlogic 四核放宽（2026-10-27 长图补录批）"
    },
    {
      "path": "memory.storageGb",
      "label": "存储",
      "unit": "GB",
      "type": "array:number",
      "range": null,
      "dir": "high",
      "quantifiable": true,
      "group": "memory",
      "note": "GB 数值数组；shuffle 以 GB 数值记"
    },
    {
      "path": "memory.ramGb",
      "label": "运行内存",
      "unit": "GB",
      "type": "array:number",
      "range": null,
      "dir": "high",
      "quantifiable": true,
      "group": "memory",
      "note": "GB 数值数组；小米电视关键参数带「内存=4GB」，智慧屏品类扩充时新增"
    },
    {
      "path": "battery.vendorClaimedHours",
      "label": "音频续航",
      "unit": "小时",
      "type": "number",
      "range": [
        3,
        60
      ],
      "dir": "high",
      "quantifiable": true,
      "group": "battery",
      "note": "官网音乐播放时长口径（classic 达 36-40h）"
    },
    {
      "path": "battery.vendorClaimedAudioHours",
      "label": "音频续航",
      "unit": "小时",
      "type": "number",
      "range": [
        8,
        60
      ],
      "dir": "high",
      "quantifiable": true,
      "group": "battery",
      "note": "iPod 本质口径；视频续航用 vendorClaimedHours"
    },
    {
      "path": "connectivity.wifi",
      "label": "无线局域网",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "connectivity",
      "note": "iPod touch 系才有 Wi-Fi；classic/nano/shuffle 记 null"
    },
    {
      "path": "connectivity.bluetooth",
      "label": "蓝牙",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "connectivity"
    },
    {
      "path": "audio.speakers",
      "label": "扬声器",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "audio",
      "note": "iPod 无扬声器记 null"
    },
    {
      "path": "connectivity.ports",
      "label": "机身接口",
      "unit": null,
      "type": "array:string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "connectivity"
    },
    {
      "path": "camera.rear",
      "label": "后置摄像头",
      "unit": null,
      "type": "array:object",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "camera",
      "note": "仅 iPod touch 4 代起有；phone schema 的 rear 子对象结构复用"
    },
    {
      "path": "os.launch",
      "label": "首发系统",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "os",
      "note": "iPod touch 走 iPhone OS/iOS；classic/nano 为固件版本记 null"
    },
    {
      "path": "device.identifier",
      "label": "机型标识符",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "Apple 内部机型标识（如 iPhone19,3 / Mac16,3），与型号号（Axxxx）不是一回事"
    },
    {
      "path": "device.modelCodes",
      "label": "型号",
      "unit": null,
      "type": "array:string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "机身/包装上的 Axxxx 型号号，多地区版本会并列多个"
    },
    {
      "path": "device.fccIds",
      "label": "FCC ID",
      "unit": null,
