{
  "_doc": "平板电脑品类参数字段表（schema v2）。按 docs/UNIVERSAL-FIELD-BLUEPRINT.md 蓝图从 phone.json 推导：屏幕/芯片/内存/存储/电池/相机/网络/系统通用，手机专属组（振动马达/卫星通信/红外/NFC 支付）不建；电池容量用 Wh（苹果官网口径，与手机 mAh 不互换算——蓝图原则 4）；重量用 g（平板介于手机与笔记本之间，仍用 g）。range 是闸门合理性区间（不是规格区间），已按 iPad 全系真实数据 + 余量设定。新增/修改字段需同步 docs/UNIVERSAL-CATALOG.md 的说明。",
  "id": "tablet",
  "label": "平板",
  "groups": [
    {
      "id": "body",
      "name": "外观与机身",
      "type": "single",
      "guide": "厚度/重量/材质/配色"
    },
    {
      "id": "display",
      "name": "屏幕显示",
      "type": "single",
      "guide": "尺寸/类型/分辨率/亮度/刷新/色域"
    },
    {
      "id": "chipset",
      "name": "处理器与性能",
      "type": "single",
      "guide": "SoC/制程/核心数/GPU/NPU"
    },
    {
      "id": "memory",
      "name": "内存与存储",
      "type": "single",
      "guide": "内存档位/存储档位/存储扩展"
    },
    {
      "id": "battery",
      "name": "电池与电源",
      "type": "single",
      "guide": "容量(Wh)/续航"
    },
    {
      "id": "camera",
      "name": "摄像头",
      "type": "multi",
      "guide": "前置+后置"
    },
    {
      "id": "audio",
      "name": "音频",
      "type": "single",
      "guide": "扬声器"
    },
    {
      "id": "connectivity",
      "name": "网络与连接",
      "type": "single",
      "guide": "WLAN/蓝牙/5G/定位/USB/eSIM"
    },
    {
      "id": "features",
      "name": "功能特性",
      "type": "single",
      "guide": "触控笔支持"
    },
    {
      "id": "os",
      "name": "系统与软件",
      "type": "single",
      "guide": "出厂系统"
    },
    {
      "id": "device",
      "name": "型号标识"
    },
    {
      "id": "security",
      "name": "安全"
    }
