      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "memory"
    },
    {
      "path": "battery.vendorClaimedHours",
      "label": "续航时间",
      "unit": "小时",
      "type": "number",
      "range": [
        12,
        510
      ],
      "dir": null,
      "quantifiable": false,
      "group": "battery",
      "note": "厂商自报「常规使用」档换算为小时（GT 系 21 天 ≈ 504h）；测试条件不一，只并列展示不参与排名；苹果不公布电池容量"
    },
    {
      "path": "battery.capacityMah",
      "label": "电池容量",
      "unit": "mAh",
      "type": "number",
      "range": [
        40,
        1000
      ],
      "dir": "high",
      "quantifiable": true,
      "group": "battery",
      "note": "手环 125-233mAh、手表 470-500mAh 量级——M3 穿戴历史批次新增"
    },
    {
      "path": "battery.capacityCaliber",
      "label": "容量口径",
      "unit": null,
      "type": "enum",
