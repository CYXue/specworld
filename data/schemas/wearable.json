{
  "_doc": "可穿戴设备品类参数字段表（schema v2）。覆盖 Apple Watch 全系（Series/SE/Ultra）。按 docs/UNIVERSAL-FIELD-BLUEPRINT.md 蓝图推导：表壳尺寸 mm + 厚度 + 重量 g；屏幕用官网口径（LTPO OLED 全天乎视网膜、单一亮度 nits——苹果不公布手表分辨率/ppi，故不建该字段）；健康传感器是多实例（array:string 官网原文）；防水用官网原文（WR 50 米/100 米，非 IP 口径）。苹果不公布手表电池 mAh → 不建容量字段，只录官网续航口径。range 按 Apple Watch 全系真实数据 + 余量设定。",
  "id": "wearable",
  "label": "可穿戴",
  "groups": [
    {
      "id": "body",
      "name": "外观与机身",
      "type": "single",
      "guide": "表壳尺寸/厚度/重量/材质/配色/防水"
    },
    {
      "id": "display",
      "name": "屏幕显示",
      "type": "single",
      "guide": "类型/亮度"
    },
    {
      "id": "chipset",
      "name": "处理器与性能",
      "type": "single",
      "guide": "SiP 芯片"
    },
    {
      "id": "memory",
      "name": "存储",
      "type": "single",
      "guide": "存储档位"
    },
    {
      "id": "battery",
      "name": "电池与续航",
      "type": "single",
      "guide": "续航时间（官网口径）"
    },
    {
      "id": "features",
      "name": "功能特性",
      "type": "single",
      "guide": "健康传感器"
    },
    {
      "id": "connectivity",
      "name": "网络与连接",
      "type": "single",
      "guide": "WLAN/蓝牙/蜂窝/NFC/定位"
    },
    {
      "id": "os",
      "name": "系统与软件",
      "type": "single",
      "guide": "出厂系统"
    },
    {
      "id": "device",
      "name": "型号标识"
    },
    {
      "id": "security",
      "name": "安全"
    }
  ],
  "fields": [
    {
      "path": "body.caseSizeMm",
      "label": "表壳尺寸",
      "unit": "mm",
      "type": "number",
      "range": [
        28,
        70
      ],
      "dir": null,
      "quantifiable": false,
      "group": "body",
      "note": "官网口径：38/40/41/42/44/45/46/49 毫米，多尺寸机型按主力尺寸录"
    },
    {
      "path": "body.thicknessMm",
      "label": "厚度",
      "unit": "mm",
      "type": "number",
      "range": [
        4,
        20
      ],
      "dir": "low",
      "quantifiable": true,
      "group": "body"
    },
    {
      "path": "body.weightG",
      "label": "重量",
      "unit": "g",
      "type": "number",
      "range": [
        5,
        300
      ],
      "dir": "low",
      "quantifiable": true,
      "group": "body",
      "note": "铝金属表壳约 34g 起，钛金属 Ultra 约 61g 封顶；下界含手环（华为手环 10 约 14g）"
    },
    {
      "path": "body.material",
      "label": "表壳材质",
      "unit": null,
      "type": "string",
      "range": null,
