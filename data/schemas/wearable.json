      "group": "body"
    },
    {
      "path": "body.colors",
      "label": "配色",
      "unit": null,
      "type": "array:string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "body"
    },
    {
      "path": "body.waterResistance",
      "label": "防水等级",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "body",
      "note": "官网原文（50 米防水/100 米防水，WR 口径），不折算 IP"
    },
    {
      "path": "display.type",
      "label": "屏幕类型",
      "unit": null,
      "type": "string",
