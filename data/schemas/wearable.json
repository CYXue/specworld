      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "铭牌强制项（制造地，如 中国深圳 / Assembled in China）"
    },
    {
      "path": "device.envUsePeriod",
      "label": "环保使用期限",
      "unit": "年",
      "type": "number",
      "range": [0, 30],
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "China RoHS 环保使用期限（环保标志圈内数字，常见 10-20 年）"
    },
    {
      "path": "device.sarHeadWkg",
      "label": "SAR 头部",
      "unit": "W/kg",
      "type": "number",
      "range": [0, 10],
      "dir": "low",
      "quantifiable": true,
