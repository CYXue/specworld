{
  "_doc": "台式电脑品类参数字段表（schema v2）。覆盖 iMac / Mac mini / Mac Studio / Mac Pro。按 docs/UNIVERSAL-FIELD-BLUEPRINT.md 蓝图推导：外观为三维尺寸（宽×高×深 mm）+ 重量 kg；屏幕组仅 iMac 适用，无屏机型（Mac mini/Studio/Pro）逐台标 not_applicable；接口是多实例（array:string 官网原文）。单位不互换算：电池组整组不建（台式机官网不公布电池参数）。range 按 Mac 全系真实数据 + 余量设定（Mac Pro 2023 重 14.9kg、iMac 27 英寸宽 525mm）。",
  "id": "desktop",
  "label": "台式电脑",
  "groups": [
    {
      "id": "body",
      "name": "外观与机身",
      "type": "single",
      "guide": "三维尺寸/重量/材质/配色"
    },
    {
      "id": "display",
      "name": "屏幕显示",
      "type": "single",
      "guide": "尺寸/类型/分辨率/亮度/刷新（仅一体机适用）"
    },
    {
      "id": "chipset",
      "name": "处理器与性能",
      "type": "single",
      "guide": "SoC/架构/核心数/GPU/NPU"
    },
    {
      "id": "memory",
      "name": "内存与存储",
      "type": "single",
      "guide": "内存档位/类型/存储档位/类型"
    },
    {
      "id": "connectivity",
      "name": "网络与接口",
      "type": "single",
      "guide": "WLAN/蓝牙/接口配置"
    },
    {
      "id": "audio",
      "name": "音频",
      "type": "single",
      "guide": "扬声器/耳机孔"
    },
    {
      "id": "os",
      "name": "系统与软件",
      "type": "single",
      "guide": "出厂系统"
    },
    {
      "id": "device",
      "name": "型号标识"
    },
    {
      "id": "security",
      "name": "安全"
    },
    {
      "id": "power",
      "name": "供电"
    },
    {
      "id": "battery",
      "name": "电池与电源",
      "type": "single",
      "guide": "容量/续航/备份电池"
    },
    {
      "id": "features",
      "name": "功能特性",
      "type": "single",
      "guide": "键盘/输入"
    }
