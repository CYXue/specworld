{
  "_doc": "笔记本电脑品类参数字段表（schema v2）。按 docs/UNIVERSAL-FIELD-BLUEPRINT.md 蓝图「笔记本适用列」从 phone.json 推导：外观/屏幕/芯片/内存/存储/电池/相机/音频/接口/系统通用；手机专属组（振动马达/NFC/卫星/SIM/eSIM）不建。单位不互换算（蓝图原则 4）：重量用 kg（笔记本级），电池用 Wh（苹果官网口径）。接口是多实例分组（array:string 官网原文数组）。range 是闸门合理性区间，按 MacBook 全系真实数据 + 余量设定（含 2006-2012 老机型：17 英寸 MacBook Pro 重 2.99kg）。",
  "id": "laptop",
  "label": "笔记本",
  "groups": [
    {
      "id": "body",
      "name": "外观与机身",
      "type": "single",
      "guide": "厚度/重量/材质/配色"
    },
    {
      "id": "display",
      "name": "屏幕显示",
      "type": "single",
      "guide": "尺寸/类型/分辨率/刷新/亮度/色域"
    },
    {
      "id": "chipset",
      "name": "处理器与性能",
      "type": "single",
      "guide": "SoC/架构/核心数/GPU/NPU"
    },
    {
      "id": "memory",
      "name": "内存与存储",
      "type": "single",
      "guide": "内存档位/类型/存储档位/类型"
    },
    {
      "id": "battery",
      "name": "电池与电源",
      "type": "single",
      "guide": "容量(Wh)/续航"
    },
    {
      "id": "camera",
      "name": "摄像头",
      "type": "single",
      "guide": "前置摄像头"
    },
    {
      "id": "audio",
      "name": "音频",
      "type": "single",
      "guide": "扬声器/耳机孔"
    },
    {
      "id": "connectivity",
      "name": "网络与接口",
      "type": "single",
      "guide": "WLAN/蓝牙/接口配置"
    },
    {
      "id": "features",
      "name": "功能特性",
      "type": "single",
      "guide": "键盘"
    },
    {
      "id": "os",
      "name": "系统与软件",
      "type": "single",
      "guide": "出厂系统"
    },
    {
      "id": "device",
      "name": "型号标识"
    },
    {
      "id": "security",
      "name": "安全"
    },
    {
      "id": "power",
      "name": "供电"
    }
  ],
  "fields": [
    {
      "path": "body.thicknessMm",
      "label": "厚度",
      "unit": "mm",
      "type": "number",
      "range": [
        5,
        110
      ],
      "dir": "low",
      "quantifiable": true,
      "group": "body",
      "note": "现代 11–18mm；PowerBook G4 26mm；iBook G3 蛤壳 46mm；PowerBook 3400c 61mm；上限由 Macintosh Portable 104mm 撑起（2026-10-15 macDB 对账批，区间必须覆盖真实数据）"
    },
    {
      "path": "body.weightKg",
      "label": "重量",
      "unit": "kg",
      "type": "number",
      "range": [
        0.7,
        8
      ],
      "dir": "low",
      "quantifiable": true,
      "group": "body",
      "note": "MacBook (12 英寸) 0.92kg 起，MacBook Pro 17 英寸 2.99kg 封顶"
    },
    {
      "path": "body.material",
      "label": "机身材质",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "body"
    },
    {
      "path": "body.colors",
      "label": "配色",
