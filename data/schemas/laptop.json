      "unit": "Hz",
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "display",
      "note": "字符串：官网原文形态（ProMotion 自适应刷新率/60Hz）。排序/算术前用 refreshHzNumber 取代表值"
    },
    {
      "path": "display.brightnessTypicalNits",
      "label": "典型亮度",
      "unit": "nits",
      "type": "number",
