      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "body"
    },
    {
      "path": "display.sizeIn",
      "label": "屏幕尺寸",
      "unit": "英寸",
      "type": "number",
      "range": [
        8,
        18
      ],
      "dir": "high",
      "quantifiable": true,
      "group": "display",
      "note": "PowerBook 100 9 英寸起步（2026-10-15 早期笔记本放宽下限）"
    },
    {
      "path": "display.type",
