{
  "_doc": "网络设备品类字段表（AirPort 路由器 / Time Capsule / Xserve 服务器起）。结构性特点：无屏、无用户系统 UI、常供电；核心参数是无线规格（802.11 代际）/以太网口数/存储（Time Capsule 内置硬盘）/机架规格（Xserve 1U）。三维按主机口径。",
  "version": 1,
  "fields": [
    {
      "path": "body.heightMm",
      "label": "高度",
      "unit": "mm",
      "type": "number",
      "range": [
        5,
        720
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "下限由 AirPort Extreme Card 扩展卡撑起（2026-10-15 macDB 对账批收录）"
    },
    {
      "path": "body.widthMm",
      "label": "宽度",
      "unit": "mm",
      "type": "number",
      "range": [
        50,
        500
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "下限由 AirPort Express 84mm 撑起（2026-10-15 macDB 对账批收录）"
    },
    {
      "path": "body.depthMm",
      "label": "厚度",
      "unit": "mm",
      "type": "number",
      "range": [
        5,
        700
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "下限含随行 WiFi 系列（12–25mm 口袋形态）；AirPort Express 84mm（2026-10-15 macDB 对账批收录）；上界含企业级机架设备"
    },
    {
      "path": "body.weightG",
      "label": "重量",
      "unit": "g",
      "type": "number",
      "range": [
        10,
        15000
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "下限由 AirPort Card / AirPort Extreme Card 撑起（2026-10-15 macDB 对账批收录）"
    },
