    {
      "path": "body.weightG",
      "label": "机身重量",
      "unit": "g",
      "type": "number",
      "range": [
        400,
        1200
      ],
      "dir": null,
      "quantifiable": true,
      "group": "body",
      "note": "含 Light Seal 与头带，官网区间口径录下限（600-650g → 600）；外置电池单独 353g 不含",
      "labelEn": "Device weight",
      "unitEn": "g"
    },
