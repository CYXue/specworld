{
  "_doc": "输入设备 schema（键盘/鼠标/触控板）。2026-10-15 建表。口径：键盘三维按 高×宽×深；鼠标按 高×宽×长。供电与连接方式是本品类核心参数（ADB→USB→蓝牙→USB-C 四代接口史）。键数只在官方公布时录（MacDB 键数口径）。",
  "fields": [
    {
      "path": "body.heightMm",
      "label": "高",
      "unit": "mm",
      "type": "number",
      "range": [
        5,
        60
      ],
      "dir": "low",
      "quantifiable": true,
      "group": "body",
      "note": "键盘 11–44mm、鼠标 21–35mm"
    },
    {
      "path": "body.widthMm",
      "label": "宽",
      "unit": "mm",
      "type": "number",
      "range": [
        50,
        500
      ],
      "dir": null,
      "quantifiable": false,
      "group": "body",
      "note": "鼠标 57–61mm、键盘 279–479mm"
    },
    {
      "path": "body.depthMm",
      "label": "深/长",
      "unit": "mm",
      "type": "number",
      "range": [
        50,
        250
      ],
      "dir": null,
      "quantifiable": false,
      "group": "body",
      "note": "鼠标 100–114mm、键盘 109–196mm"
    },
    {
      "path": "body.weightG",
      "label": "重量",
      "unit": "g",
      "type": "number",
      "range": [
        40,
        1500
      ],
      "dir": "low",
      "quantifiable": true,
      "group": "body",
      "note": "鼠标 99–132g、键盘 231–1200g"
    },
    {
      "path": "body.colors",
      "label": "配色",
      "unit": null,
      "type": "array:string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "body"
    },
    {
      "path": "input.buttons",
      "label": "按键/按钮数",
      "unit": "个",
      "type": "number",
      "range": [
        0,
        120
      ],
      "dir": null,
      "quantifiable": false,
      "group": "input",
      "note": "鼠标 1–4 按钮；键盘为总键数 76–109"
    },
    {
      "path": "input.tracking",
      "label": "追踪方式",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "input",
      "note": "机械滚珠/光电/激光/多点触控/力度触控"
    },
    {
      "path": "connectivity.type",
      "label": "连接方式",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "connectivity",
      "note": "ADB/USB/蓝牙/蓝牙+USB-C 四代接口史"
    },
    {
      "path": "connectivity.bluetooth",
      "label": "蓝牙",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "connectivity"
    },
    {
      "path": "power.type",
      "label": "供电",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "power",
      "note": "USB 总线/内置锂电/AA 电池/串口直供"
    },
    {
      "path": "power.batteryLifeMonths",
      "label": "电池续航",
      "unit": "月",
      "type": "number",
      "range": [
        1,
        10
      ],
      "dir": "high",
      "quantifiable": true,
      "group": "power",
      "note": "官网口径「约一个月或更长」按 1 记；2003 键盘宣称 9 个月"
    },
    {
      "path": "os.launch",
      "label": "首发系统要求",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "os",
      "note": "官方系统要求口径"
    },
    {
      "path": "device.identifier",
      "label": "机型标识符",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "Apple 内部机型标识（如 iPhone19,3 / Mac16,3），与型号号（Axxxx）不是一回事"
    },
    {
      "path": "device.modelCodes",
      "label": "型号",
      "unit": null,
      "type": "array:string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "机身/包装上的 Axxxx 型号号，多地区版本会并列多个"
    },
    {
      "path": "device.fccIds",
      "label": "FCC ID",
      "unit": null,
      "type": "array:string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "监管编号（如 BCG‑E9187A），可到 fccid.io 反查射频与 SAR 测试报告"
    },
    {
      "path": "device.orderNumbers",
      "label": "订购编号",
      "unit": null,
      "type": "array:string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "官方订购编号（如 MX532AM/A），多套装/多地区并列"
    },
    {
      "path": "device.codename",
      "label": "开发代号",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": null
    },
    {
      "path": "device.ctaNo",
      "label": "进网许可证编号",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "工信部进网许可标志三行信息之一；国行蜂窝机型才有，海外版/非蜂窝 unknown 或 not_applicable。jwxk.miit.gov.cn 可验真"
    },
    {
      "path": "device.srrcId",
      "label": "CMIIT ID",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "SRRC 无线电发射设备型号核准代码（如 26J44XA31643）；含射频器件（WLAN/蓝牙/蜂窝）的设备均需核准。只存原文"
    },
    {
      "path": "device.origin",
      "label": "产地",
      "unit": null,
      "type": "string",
      "range": null,
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "铭牌强制项（制造地，如 中国深圳 / Assembled in China）"
    },
    {
      "path": "device.envUsePeriod",
      "label": "环保使用期限",
      "unit": "年",
      "type": "number",
      "range": [0, 30],
      "dir": null,
      "quantifiable": false,
      "group": "device",
      "note": "China RoHS 环保使用期限（环保标志圈内数字，常见 10-20 年）"
    }
  ],
  "groups": [
    {
