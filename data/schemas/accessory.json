      "label": "高",
      "unit": "mm",
      "type": "number",
      "range": [
        8,
        200
      ],
      "dir": null,
      "quantifiable": false,
      "group": "body",
      "note": "上限由 Apple Pencil 166mm 与 Siri Remote 136mm 撑起；下限由 MagSafe 电池 11mm 级别撑起（2026-10-15 macDB 对账批）"
    },
    {
      "path": "body.widthMm",
      "label": "宽",
      "unit": "mm",
      "type": "number",
      "range": [
        8,
        120
      ],
      "dir": null,
      "quantifiable": false,
      "group": "body",
      "note": "下限由 Apple Pencil 直径 9mm 撑起（2026-10-15 macDB 对账批收录触控笔）"
    },
    {
